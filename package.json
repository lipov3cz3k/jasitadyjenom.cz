{
  "name": "jasitadyjenom",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p data-pipeline && tsc --noEmit -p src/sw",
    "data:update": "npm --prefix data-pipeline run update",
    "test": "vitest run",
    "predev": "node scripts/copy-vendor.mjs",
    "prebuild": "node scripts/copy-vendor.mjs"
  },
  "dependencies": {
    "@google/genai": "3.0.0",
    "exifreader": "4.54.0",
    "maplibre-gl": "6.16.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@serwist/turbopack": "9.5.13",
    "@tailwindcss/postcss": "4.3.5",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "serwist": "9.5.13",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "@swc/core": false,
    "esbuild": false,
    "exifreader": false,
    "protobufjs": false
  },
  "overrides": {
    "@serwist/build": {
      "zod": "4.6.7"
    },
    "@serwist/turbopack": {
      "zod": "4.6.7"
    }
  }
}
