# AI pre-fill of the report form (src/app/api/analyze). Copy to .env.local and fill in ONE option.

# Option A – Vertex AI, same as production (gcloud auth application-default login)
# GOOGLE_CLOUD_PROJECT=jasitadyjenom
# GOOGLE_CLOUD_LOCATION=eu

# Option B – Gemini API key from https://aistudio.google.com/apikey (takes precedence when set)
# GEMINI_API_KEY=

# Optional
# GEMINI_MODEL=gemini-3.5-flash-lite
# AI_LIMIT_PER_HOUR=10
# AI_LIMIT_PER_DAY=500
